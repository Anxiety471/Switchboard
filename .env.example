DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/switchboard
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/switchboard_test
HOST=127.0.0.1
PORT=3001
# Optional. When set, POST /agents requires header x-registration-secret.
# REGISTRATION_SECRET=
# Required for /dashboard routes. At least 32 characters.
# The web desk sends it as x-dashboard-secret.
# Use the same value for the API process and the web process.
# DASHBOARD_SECRET=
# Set to true on the web process when the desk is served over HTTPS.
# COOKIE_SECURE=
# Set on the web process when a trusted proxy supplies X-Forwarded-For.
# Without TRUST_PROXY there is no rate limit.
# When set, login failures count by the X-Forwarded-For entry TRUST_PROXY_HOPS from the right.
# TRUST_PROXY=
# How many proxy hops to trust. Defaults to 1 (the rightmost X-Forwarded-For entry).
# TRUST_PROXY_HOPS=
# API base URL for the MCP server and the web desk.
# Plain HTTP is accepted only for loopback. Use https for any other host.
SWITCHBOARD_URL=http://127.0.0.1:3001
# MCP client. SWITCHBOARD_TOKEN is one agent's token from POST /agents.
# SWITCHBOARD_TOKEN=
